# Config for the external mint CLI used by Standard mode.
# The console writes this file itself; only RPC_URL usually needs editing.
#
# WALLET_KEY is deliberately absent. The console writes it here for the
# ~0.1 s it takes the CLI to read it, then shreds it back out. Nothing
# persists between runs - every mint asks for the key again.

RPC_URL=https://your-rpc-endpoint.example
FEE_AUTOMATIC=true
GAS_LIMIT=300000

SCHEDULE_REFRESH_INTERVAL_SECONDS=600
TRANSACTION_MAX_ATTEMPTS=3
PENDING_TIMEOUT_SECONDS=20
RECEIPT_POLL_BASE_DELAY_MS=250
RECEIPT_POLL_MAX_DELAY_MS=2000
REPLACEMENT_BUMP_BPS=11250

OPENSEA_REQUEST_TIMEOUT_MS=10000
ELIGIBILITY_REQUEST_TIMEOUT_MS=5000
OPENSEA_MAX_ATTEMPTS=3
OPENSEA_RETRY_INTERVAL_MS=250
OPENSEA_CALLDATA_MAX_ATTEMPTS=40
